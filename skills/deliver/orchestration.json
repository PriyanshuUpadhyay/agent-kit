{
  "$schema": "../../../../skills/contracts/orchestration-requirements.schema.json",
  "version": 1,
  "workflow_kind": "deliver-iterative",
  "activation": {
    "required_for": [
      "build",
      "prove"
    ],
    "serial_without_runtime": [
      "decide",
      "design"
    ],
    "unavailable_required_gate_result": "delivery-blocked"
  },
  "required_operations": [
    "resolve_roles",
    "validate_host_capabilities",
    "create_owned_visible_leaves",
    "dispatch",
    "accept_durable_results",
    "report_degradation",
    "close_owned_leaves"
  ],
  "roles": [
    "code.routine",
    "review.deep"
  ],
  "role_policy": {
    "code.routine": "repository writes only to its disjoint contracted files; no version control, descendants, decisions, or notifications",
    "review.deep": "repository inspection and attributed scratch result only; no repository edits, applied findings, version control, descendants, or notifications",
    "host_visibility": "required",
    "inline_substitute": "forbidden"
  },
  "seat_template": {
    "isolation": "fresh context per implementation lane or independent proof lane",
    "visibility": "host-visible owned foreground pane",
    "permission": "role-bound contracted file writes for implementers; repository read and scratch-result writes only for reviewers",
    "artifact": "durable attributed lane report with input digest, changed-file digests, commands, exit codes, line delta, and verdict",
    "deadline": "one bounded iteration deadline"
  },
  "execution": {
    "orchestrator_product_writes": "forbidden",
    "implementation_ownership": "one disjoint file set per lane",
    "version_control_owner": "root orchestrator only",
    "return_verification": "all returned files and report fields",
    "review_independence": "reviewer did not author any reviewed file"
  },
  "refusals": [
    {
      "condition": "runtime-adapter-unavailable",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "host-capability-unavailable",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "role-unresolved",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "route-capability-mismatch",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "visible-leaf-unavailable",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "duplicate-file-owner",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "completion-artifact-invalid",
      "detectable": "post-dispatch",
      "side_effects_may_have_occurred": true,
      "disposition": "quarantine-and-escalate"
    },
    {
      "condition": "unowned-file-change",
      "detectable": "post-dispatch",
      "side_effects_may_have_occurred": true,
      "disposition": "quarantine-and-escalate"
    },
    {
      "condition": "reviewer-independence-unsatisfied",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "teardown-target-unowned",
      "detectable": "post-dispatch",
      "side_effects_may_have_occurred": true,
      "disposition": "quarantine-and-escalate"
    }
  ],
  "result_routing": {
    "implementation_report": "verify every declared file against actual bytes before acceptance",
    "review_report": "record confirmed findings in the task file and route fixes through the next iteration",
    "unavailable_or_invalid": "record the blocker in the task file and stop; do not claim the exit condition passed",
    "unresolved_user_decision": "record the open decision and stop the work that depends on it"
  },
  "trace_cases": [
    {
      "id": "explicit-delivery",
      "events": [
        "explicit-entry",
        "exit-condition-stated",
        "visible-implementation-lanes",
        "all-returns-verified",
        "independent-proof-lane",
        "check-fails",
        "next-iteration",
        "check-passes",
        "commit-progress",
        "exit-condition-met",
        "delivery-complete"
      ]
    },
    {
      "id": "implicit-request-refused",
      "events": [
        "ordinary-implementation-request",
        "no-explicit-entry",
        "deliver-not-entered"
      ]
    },
    {
      "id": "build-without-host",
      "events": [
        "implementation-requested",
        "host-unavailable",
        "delivery-blocked",
        "no-product-edit"
      ]
    },
    {
      "id": "irreversible-action-pauses",
      "events": [
        "check-passes",
        "commit-progress",
        "push-requested-without-approval",
        "await-user-approval",
        "no-push"
      ]
    }
  ]
}
