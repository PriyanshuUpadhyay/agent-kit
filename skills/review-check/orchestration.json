{
  "version": 1,
  "workflow_kind": "review-check",
  "required_operations": [
    "resolve_roles",
    "validate_host_capabilities",
    "create_owned_visible_leaves",
    "dispatch",
    "accept_durable_results",
    "report_degradation",
    "close_owned_leaves"
  ],
  "roles": [
    "review.deep"
  ],
  "seat_template": {
    "isolation": "one seat per set of units; seats do not read each other's review files",
    "visibility": "host-visible owned leaf",
    "permission": "reads the repository and the run folder; writes only its own 02-review-<n>.md; no repository edits, no commits",
    "artifact": "02-review-<n>.md under <repo>/tmp/review-check/<run>/, with one row for each assigned unit",
    "deadline": "bounded by the chair"
  },
  "refusals": [
    {
      "condition": "runtime-adapter-unavailable",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "host-capability-unavailable",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "role-unresolved",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "degrade-and-report"
    },
    {
      "condition": "route-capability-mismatch",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "completion-artifact-invalid",
      "detectable": "post-dispatch",
      "side_effects_may_have_occurred": true,
      "disposition": "refuse"
    },
    {
      "condition": "teardown-target-unowned",
      "detectable": "post-dispatch",
      "side_effects_may_have_occurred": true,
      "disposition": "quarantine-and-escalate"
    }
  ],
  "result_routing": {
    "review_files": "the chair runs verdict; a gap goes back to the seat that owns the unit, or the chair reviews it",
    "verdict": "03-verdict.md line 3, written only by the script and read by flow, deliver, and review-walk"
  },
  "trace_cases": [
    {
      "id": "happy-path",
      "events": [
        "start:01-units",
        "dispatch:02-review-1..n",
        "verdict:03-verdict"
      ]
    },
    {
      "id": "gap",
      "events": [
        "start:01-units",
        "dispatch:02-review-1..n",
        "verdict:INCOMPLETE",
        "missing-units-reviewed",
        "verdict:03-verdict"
      ]
    }
  ],
  "role_policy": {
    "disposition": "report-only"
  }
}
