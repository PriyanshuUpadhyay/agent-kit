{
  "version": 1,
  "workflow_kind": "review-walk",
  "required_operations": [
    "resolve_roles",
    "validate_host_capabilities",
    "create_owned_visible_leaves",
    "dispatch",
    "accept_durable_results",
    "report_degradation",
    "close_owned_leaves"
  ],
  "roles": [
    "review.deep"
  ],
  "seat_template": {
    "isolation": "one seat per review step (03, 04 or 05); seats do not read each other's step files",
    "visibility": "host-visible owned leaf",
    "permission": "reads the repository and the run folder; writes only its own step file; no repository edits, no GitHub writes, no commits",
    "artifact": "the step file under <repo>/tmp/review-walk/<run>/, with line 1 set to done or skipped",
    "deadline": "bounded by the chair"
  },
  "refusals": [
    {
      "condition": "runtime-adapter-unavailable",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "host-capability-unavailable",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "role-unresolved",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "degrade-and-report"
    },
    {
      "condition": "route-capability-mismatch",
      "detectable": "pre-dispatch",
      "side_effects_may_have_occurred": false,
      "disposition": "refuse"
    },
    {
      "condition": "completion-artifact-invalid",
      "detectable": "post-dispatch",
      "side_effects_may_have_occurred": true,
      "disposition": "refuse"
    },
    {
      "condition": "teardown-target-unowned",
      "detectable": "post-dispatch",
      "side_effects_may_have_occurred": true,
      "disposition": "quarantine-and-escalate"
    }
  ],
  "result_routing": {
    "step_file": "the chair checks each finding quote against diff.patch, then keeps the step done or reopens it",
    "comments": "06-comments.md, then the pending review after the user says yes",
    "verdict": "06-comments.md line 3, read by flow and deliver"
  },
  "trace_cases": [
    {
      "id": "happy-path",
      "events": [
        "start:01-scope",
        "map:02-map",
        "dispatch:03-cleanup,04-logic,05-rules",
        "findings-checked",
        "draft:06-comments",
        "user-yes",
        "post",
        "walk:07-walk"
      ]
    },
    {
      "id": "new-round",
      "events": [
        "start:01-scope",
        "previous-run-viewed-read",
        "remark-offered",
        "since-view-only-files-reviewed"
      ]
    }
  ],
  "role_policy": {
    "disposition": "report-only"
  }
}
